# ============================================================
#  FitCoach Pro — configuración del servidor
#  Copia este archivo como .env y completa los valores.
#  NUNCA subas el archivo .env a GitHub.
# ============================================================

NODE_ENV=production
PORT=3000

# Zona horaria para fechas de cobro y mensualidades (Ecuador)
TZ=America/Guayaquil

# Secretos (mínimo 32 caracteres). Genera cada uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
FILE_SECRET=

# Base de datos MySQL (Hostinger: hPanel > Bases de datos)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Carpeta privada para fotos y comprobantes (fuera de la carpeta pública)
UPLOAD_DIR=data/uploads

# Primer administrador: se crea al arrancar si no existe ninguno.
# Después de crearlo, borra ADMIN_PASSWORD de este archivo.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador

# Detrás del proxy de Hostinger (para que el límite de intentos use la IP real)
TRUST_PROXY=1

# Otros orígenes permitidos (separados por coma). La app Android ya está incluida.
CORS_ORIGINS=
